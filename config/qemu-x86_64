# --- Architecture & Boot Vector ---
CONFIG_X86=y
CONFIG_X86_RUN_64=y
CONFIG_BUILD_ROM=y
CONFIG_ROM_SIZE=2097152
CONFIG_SYS_X86_START16=0xfffff000

# --- Console & Boot ---
CONFIG_DEBUG_UART=y
CONFIG_DEBUG_UART_BASE=0x3f8
CONFIG_DEBUG_UART_CLOCK=1843200
CONFIG_BAUDRATE=115200
CONFIG_BOOTDELAY=5

# --- Secure Boot (FIT & RSA) ---
CONFIG_FIT=y
CONFIG_FIT_SIGNATURE=y
CONFIG_FIT_SIGNATURE_MAX_SIZE=0x10000000
CONFIG_RSA=y
CONFIG_RSA_SOFTWARE_EXP=y
CONFIG_RSA_VERIFY_WITH_PKEY=y
CONFIG_FIT_VERBOSE=y
CONFIG_FIT_BEST_MATCH=y
CONFIG_FIT_RSASSA_PSS=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_RSA_PUBLIC_KEY_PARSER=y

# --- Measured Boot (TPM 2.0) ---
CONFIG_TPM=y
CONFIG_TPM_V2=y
CONFIG_TPM2_MMIO=y
CONFIG_CMD_TPM=y
CONFIG_CMD_TPM_TEST=y
CONFIG_MEASURED_BOOT=y
CONFIG_MEASURE_DEVICETREE=y
CONFIG_MEASURE_IGNORE_LOG=y
CONFIG_TPM2_EVENT_LOG_SIZE=8192

# --- EFI Security (Optional but recommended) ---
CONFIG_EFI_SECURE_BOOT=y
CONFIG_EFI_TCG2_PROTOCOL=y
CONFIG_EFI_TCG2_PROTOCOL_MEASURE_DTB=y

# --- Verified Boot Boot Command ---
# Scan for a virtio block device (boot.img), read the FIT image and verify it.
# Fails closed: no distro_bootcmd fallback — a signature failure halts boot.
CONFIG_BOOTCOMMAND="virtio scan; virtio read 0x01000000 0 0x100; bootm 0x01000000"

# --- Console Lockdown (Keyed Autoboot) ---
# Only a passphrase (SHA256-hashed at compile time) can interrupt autoboot.
# Any other key press is silently ignored — no shell without the password.
#
# Demo passphrase: stop
# Regenerate hash: printf '%s' '<passphrase>' | sha256sum
CONFIG_AUTOBOOT_KEYED=y
CONFIG_AUTOBOOT_FLUSH_STDIN=y
CONFIG_AUTOBOOT_ENCRYPTION=y
CONFIG_AUTOBOOT_STOP_STR_ENABLE=y
CONFIG_AUTOBOOT_STOP_STR_SHA256="6c45cb72a36e63d522aa54ed8adbd7a29a989474f2f77e0458af8800564ef3cb"
CONFIG_AUTOBOOT_PROMPT="Passphrase required to abort autoboot (%d s) — type silently\n"

# --- Hardened Defaults ---
# No persistent environment — prevents runtime tampering via saveenv
CONFIG_ENV_IS_NOWHERE=y
# Restrict writable environment variables to an explicit allowlist
CONFIG_ENV_WRITEABLE_LIST=y

